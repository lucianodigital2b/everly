{
  "expo": {
    "name": "Everly",
    "slug": "everly-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5EDEA"
    },
    "scheme": "everly",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "appleTeamId": "V2QJCDN95Z",
      "bundleIdentifier": "com.get.everly",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Everly needs access to your camera to take photos for events.",
        "NSMicrophoneUsageDescription": "Everly needs access to your microphone for video recording.",
        "NSPhotoLibraryUsageDescription": "Everly needs access to your photo library to upload photos to events.",
        "NSUserNotificationsUsageDescription": "Everly needs to send you notifications about event updates and reveals.",
        "NSSupportsLiveActivities": true,
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5EDEA"
      },
      "package": "com.get.everly",
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-updates",
      "expo-asset",
      [
        "react-native-appsflyer",
        {
          "shouldUseStrictMode": false,
          "shouldUsePurchaseConnector": false,
          "preferAppsFlyerBackupRules": false
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Everly uses this to measure ad performance and improve your experience. Your data is never sold."
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "3087a1be-3122-4ba6-bb7c-2b1bccbef4d0"
      }
    },
    "owner": "the-everly-org"
  }
}
