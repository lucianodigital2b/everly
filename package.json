    "prebuild:prod": "expo prebuild --clean",
    "update:dev": "cross-env APP_VARIANT=development eas update --branch development",
    "update:preview": "cross-env APP_VARIANT=preview eas update --branch preview",
    "update:prod": "eas update --branch production"
